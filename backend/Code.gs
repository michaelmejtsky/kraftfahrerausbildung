function kfAblaufErinnerungen(){return kfLock_(()=>{if(!kfFeaturesReady_())return {ok:false,message:'Zuerst kfErweiterungenEinrichten ausführen.'};const today=kfToday_(),members=kfRows_('Members').filter(m=>m.active);kfRows_('Evidence').filter(e=>e.approved&&members.some(m=>m.id===e.memberId)).forEach(e=>{const m=members.find(m=>m.id===e.memberId);kfEvidenceWarnings_(e).forEach(w=>{const days=Math.round((new Date(w.expires+'T12:00:00Z')-new Date(today+'T12:00:00Z'))/86400000),stage=days<0?'abgelaufen:'+today.slice(0,7):days<=7?'7':days<=30?'30':'monat:'+today.slice(0,7),key='expiry:'+e.id+':'+e.approved.fileId+':'+w.label+':'+w.expires+':'+stage,title=days<0?'Nachweis abgelaufen – Erneuerung erforderlich':'Nachweis läuft innerhalb von sechs Monaten ab',text=m.firstName+' '+m.lastName+': '+w.label+' läuft am '+w.expires+' ab'+(days<0?' (bereits abgelaufen)':'')+'. Bitte erneuern und das neue Dokument mit Gültigkeitsangaben hochladen. Die Warnung bleibt bis zur Bestätigung der Erneuerung sichtbar.';[m.userId,...kfChiefs_().map(c=>c.id)].filter((id,i,a)=>id&&a.indexOf(id)===i).forEach(id=>{kfNotify_(id,key,title,text,e.id);kfMail_(id,key,'expiry',title,text,e);});});});kfStaffProofReminders_(today);return {ok:true};});}
