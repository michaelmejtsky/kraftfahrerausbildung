function kfEnrollment_(u,id){const e=kfFind_('Enrollments',id);if(!e)throw Error('Ausbildung nicht zugeordnet.');kfMemberAccess_(u,e.memberId);return e;}
function kfTheoryOk_(e){return !e.requirements.theoryEnabled||(e.requirements.quizRequired?!!e.quizPassed:!!e.theoryLearned);}
function kfProgress_(e){const lessons=kfRows_('Lessons').filter(l=>l.enrollmentId===e.id&&!l.void),count=lessons.length;return {...e,lessons:count,theoryOk:kfTheoryOk_(e),canExam:kfTheoryOk_(e)&&count>=e.requirements.requiredSessions};}
function kfLicenceOkBase_(m,v){const required=v.requiredClasses||[];if(!required.length)return true;return required.some(c=>(m.licences||[]).some(l=>l.class===c&&(!l.expires||l.expires>=kfToday_())));}
function kfPrereqsOk_(e){const all=kfRows_('Enrollments');return (e.requirements.prerequisiteVehicleIds||[]).every(id=>all.some(x=>x.memberId===e.memberId&&x.vehicleId===id&&x.completedAt));}
function kfAssign_(u,m,course){if(!course.active)throw Error('Ausbildung ist inaktiv.');if(kfRows_('Enrollments').some(x=>x.memberId===m.id&&x.courseId===course.id))return;const v=kfFind_('Vehicles',course.vehicleId);if(!v||!v.active)throw Error('Fahrzeug nicht aktiv.');kfSave_('Enrollments',{id:kfId_(),memberId:m.id,courseId:course.id,vehicleId:course.vehicleId,assignedAt:kfNow_(),assignedBy:u.id,courseRevision:course.revision,requirements:{theoryEnabled:course.theoryEnabled,quizRequired:!!(course.theoryEnabled&&course.quiz.enabled&&course.quiz.required),requiredSessions:course.requiredSessions,practicalEnabled:course.practicalEnabled,prerequisiteVehicleIds:course.prerequisiteVehicleIds||[]},quizSnapshot:course.quiz,theoryLearned:'',quizPassed:null,completedAt:'',recognition:null});kfNotify_(m.userId,'assigned:'+course.id,'Neue Fahrzeugausbildung',course.title+' wurde dir zugeordnet.',course.id);}
function kfStateBase_(u){const staff=['admin','chief','trainer'].includes(u.role),me=staff?null:kfOwnMember_(u),members=staff?kfRows_('Members'): [me],ids=members.map(m=>m.id),es=kfRows_('Enrollments').filter(e=>ids.includes(e.memberId)),courseIds=es.map(e=>e.courseId),cs=kfRows_('Courses').filter(c=>staff||courseIds.includes(c.id)),vs=kfRows_('Vehicles').filter(v=>staff||es.some(e=>e.vehicleId===v.id));const attempts=kfRows_('Attempts').filter(a=>ids.includes(a.memberId)).map(({questions,answers,...a})=>a);return {version:KF.version,user:kfPublic_(u),trainers:kfRows_('Users').filter(x=>x.active&&['admin','chief','trainer'].includes(x.role)).map(x=>({id:x.id,name:x.name,number:x.number||''})),members,users:staff?kfRows_('Users').map(kfPublic_):[],vehicles:vs,courses:cs.map(c=>staff?c:kfCoursePublic_(c)),enrollments:es.map(e=>{const p=kfProgress_(e);if(!staff)delete p.quizSnapshot;return p;}),lessons:kfRows_('Lessons').filter(l=>es.some(e=>e.id===l.enrollmentId)),attempts,appointments:kfRows_('Appointments').filter(a=>staff||ids.includes(a.memberId)),notifications:kfRows_('Notifications').filter(n=>n.userId===u.id).sort((a,b)=>b.at.localeCompare(a.at)).slice(0,150),files:kfRows_('Files').filter(f=>ids.includes(f.memberId)).map(({driveId,...f})=>f),reports:staff?kfRows_('Reports').map(({pdfDriveId,...r})=>r):[],reportAutoEmail:!!PropertiesService.getScriptProperties().getProperty('KF_REPORT_RECIPIENTS'),reportRecipients:u.role==='admin'?(PropertiesService.getScriptProperties().getProperty('KF_REPORT_RECIPIENTS')||''):'',appUrl:PropertiesService.getScriptProperties().getProperty('KF_APP_URL')||''};}
function kfSaveMemberBase_(u,d){kfStaff_(u);const old=d.id&&kfFind_('Members',d.id);if(d.id&&!old)throw Error('Mitglied nicht gefunden.');const email=kfEmail_(d.email),users=kfRows_('Users'),dupe=users.find(x=>x.email===email&&x.id!==(old&&old.userId));if(dupe)throw Error('E-Mail wird bereits von einem anderen Konto verwendet.');const firstName=kfText_(d.firstName,80),lastName=kfText_(d.lastName,80),number=kfText_(d.number,40);if(!firstName||!lastName||!number)throw Error('Vorname, Nachname und Standesbuchnummer erforderlich.');if(kfRows_('Members').some(m=>m.number===number&&m.id!==(old&&old.id)))throw Error('Standesbuchnummer bereits vorhanden.');const allowed=['AM','A1','A2','A','B','BE','C1','C1E','C','CE','D1','D1E','D','DE','F'];const licences=(d.licences||[]).map(l=>{if(!allowed.includes(l.class))throw Error('Ungültige Führerscheinklasse.');return {class:l.class,expires:kfDate_(l.expires)};});const account=old&&kfFind_('Users',old.userId);if(old&&(!account||account.role!=='participant'))throw Error('Kontozuordnung fehlerhaft.');const user={...(account||{}),id:account?account.id:kfId_(),name:firstName+' '+lastName,email,role:'participant',active:d.active!==false,createdAt:account?account.createdAt:kfNow_()};const m={...(old||{}),id:old?old.id:kfId_(),userId:user.id,firstName,lastName,number,email,phone:kfText_(d.phone,60),startDate:kfDate_(d.startDate)||kfToday_(),licences,fireLicenceExpires:kfDate_(d.fireLicenceExpires),active:user.active,createdAt:old?old.createdAt:kfNow_()};kfSave_('Users',user);kfSave_('Members',m);if(old&&account.email!==email)kfRows_('Invites').filter(x=>x.userId===user.id&&!x.usedAt).forEach(x=>kfSave_('Invites',{...x,usedAt:kfNow_(),revoked:true}));if(!old)kfRows_('Courses').filter(c=>c.active&&(!c.effectiveFrom||m.startDate>=c.effectiveFrom)).forEach(c=>kfAssign_(u,m,c));kfLog_(u,'saveMember',m.id,{emailChanged:!!old&&old.email!==email});return m;}
function kfSaveUserBase_(u,d){kfAdmin_(u);const old=d.id&&kfFind_('Users',d.id);if(d.id&&!old)throw Error('Konto nicht gefunden.');if(old&&old.role==='participant')throw Error('Teilnehmer bitte in der Teilnehmerverwaltung bearbeiten.');if(!['admin','chief','trainer'].includes(d.role))throw Error('Ungültige Rolle.');if(old&&old.id===u.id&&(d.active===false||d.role!=='admin'))throw Error('Eigenen Administratorzugang nicht deaktivieren oder herabstufen.');const email=kfEmail_(d.email);if(kfRows_('Users').some(x=>x.email===email&&x.id!==d.id))throw Error('E-Mail bereits vergeben.');const name=kfText_(d.name,160);if(!name)throw Error('Name fehlt.');const record={...(old||{}),id:old?old.id:kfId_(),name,email,number:kfText_(d.number,40),role:d.role,active:d.active!==false,createdAt:old?old.createdAt:kfNow_()};kfSave_('Users',record);if(old&&old.email!==email)kfRows_('Invites').filter(x=>x.userId===old.id&&!x.usedAt).forEach(x=>kfSave_('Invites',{...x,revoked:true}));kfLog_(u,'saveUser',record.id);return kfPublic_(record);}
function kfSaveVehicle_(u,d){kfStaff_(u);const old=d.id&&kfFind_('Vehicles',d.id);if(d.id&&!old)throw Error('Fahrzeug fehlt.');const name=kfText_(d.name,150);if(!name)throw Error('Fahrzeugname fehlt.');const rooms=(d.rooms||[]).map(r=>({id:r.id||kfId_(),name:kfText_(r.name,100),items:(r.items||[]).map(i=>({id:i.id||kfId_(),name:kfText_(i.name,140),description:kfText_(i.description,700)}))}));if(rooms.length>30||rooms.some(r=>!r.name||r.items.length>100||r.items.some(i=>!i.name)))throw Error('Geräteräume/Beladung prüfen (max. 30 Räume, je 100 Geräte).');const record={id:old?old.id:kfId_(),name,description:kfText_(d.description,2500),technicalData:kfText_(d.technicalData,10000),order:kfNum_(d.order||1,1,999),requiredClasses:Array.isArray(d.requiredClasses)?d.requiredClasses.map(x=>kfText_(x,5)).slice(0,16):[],rooms,active:d.active!==false,updatedAt:kfNow_(),createdAt:old?old.createdAt:kfNow_()};kfSave_('Vehicles',record);kfLog_(u,'saveVehicle',record.id);return record;}
function kfValidateQuiz_(q){q=q||{};const questions=(q.questions||[]).map(x=>{const type=x.type||'choice',r={id:x.id||kfId_(),type,text:kfText_(x.text,1000)};if(!r.text)throw Error('Fragetext fehlt.');if(type==='choice'||type==='boolean'){r.options=(x.options||[]).map(s=>kfText_(s,400));if(r.options.length<2||r.options.length>8||r.options.some(s=>!s))throw Error('Mindestens zwei Antwortmöglichkeiten erforderlich.');r.correct=kfNum_(x.correct,0,r.options.length-1);}else if(type==='allocation'){r.items=(x.items||[]).map(i=>({id:i.id||kfId_(),name:kfText_(i.name,200),correctRoomId:kfText_(i.correctRoomId,100)}));r.rooms=(x.rooms||[]).map(s=>({id:kfText_(s.id,100),name:kfText_(s.name,120)}));if(!r.items.length||!r.rooms.length||r.items.length>50||r.items.some(i=>!i.name||!r.rooms.some(room=>room.id===i.correctRoomId)))throw Error('Zuordnungsfrage: Geräte und korrekte Geräteräume fehlen.');}else throw Error('Unbekannter Fragetyp.');return r;});if(q.enabled&&!questions.length)throw Error('Für ein aktives Quiz mindestens eine Frage anlegen.');if(questions.length>60)throw Error('Maximal 60 Fragen.');return {enabled:!!q.enabled,required:!!q.required,passPercent:kfNum_(q.passPercent||80,1,100),maxAttempts:kfNum_(q.maxAttempts||3,1,20),questions};}
function kfSaveCourseBase_(u,d){kfStaff_(u);const old=d.id&&kfFind_('Courses',d.id);if(d.id&&!old)throw Error('Ausbildung fehlt.');const vehicle=kfFind_('Vehicles',d.vehicleId);if(!vehicle)throw Error('Fahrzeug wählen.');if(old&&old.vehicleId!==d.vehicleId)throw Error('Fahrzeugzuordnung eines bestehenden Kurses nicht ändern.');if(kfRows_('Courses').some(c=>c.vehicleId===d.vehicleId&&c.active&&c.id!==d.id&&d.active!==false))throw Error('Für dieses Fahrzeug gibt es bereits eine aktive Ausbildung. Bitte diese bearbeiten.');const title=kfText_(d.title,160);if(!title)throw Error('Bezeichnung fehlt.');const quiz=kfValidateQuiz_(d.quiz);if(!d.theoryEnabled&&quiz.enabled)throw Error('Quiz erfordert aktivierte Theorie.');const prerequisites=(d.prerequisiteVehicleIds||[]).filter(id=>id!==vehicle.id);if(prerequisites.length!==(d.prerequisiteVehicleIds||[]).length)throw Error('Ein Fahrzeug darf nicht seine eigene Voraussetzung sein.');if(prerequisites.some(id=>!kfFind_('Vehicles',id)))throw Error('Voraussetzungsfahrzeug fehlt.');const graph={};kfRows_('Courses').filter(c=>c.active&&c.id!==d.id).forEach(c=>graph[c.vehicleId]=c.prerequisiteVehicleIds||[]);graph[vehicle.id]=prerequisites;const visit=(id,path)=>{if(path.includes(id))throw Error('Zirkuläre Fahrzeugreihenfolge nicht erlaubt.');(graph[id]||[]).forEach(p=>visit(p,path.concat(id)));};visit(vehicle.id,[]);const record={id:old?old.id:kfId_(),vehicleId:vehicle.id,title,content:kfText_(d.content,10000),objectives:kfText_(d.objectives,5000),presentation:kfUrl_(d.presentation),materials:(d.materials||[]).map(x=>({name:kfText_(x.name,120),url:kfUrl_(x.url)})).filter(x=>x.url),workMaterials:kfText_(d.workMaterials,4000),responsibleTrainerIds:(d.responsibleTrainerIds||[]).filter(id=>kfRows_('Users').some(x=>x.id===id&&['admin','chief','trainer'].includes(x.role))),sections:(d.sections||[]).map(s=>({title:kfText_(s.title,200),body:kfText_(s.body,6000)})),requiredSessions:Math.floor(kfNum_(d.requiredSessions==null?1:d.requiredSessions,0,50)),theoryEnabled:!!d.theoryEnabled,practicalEnabled:d.practicalEnabled!==false,effectiveFrom:kfDate_(d.effectiveFrom),prerequisiteVehicleIds:prerequisites,quiz,revision:old?old.revision+1:1,active:d.active!==false,updatedAt:kfNow_(),createdAt:old?old.createdAt:kfNow_()};kfSave_('Courses',record);kfLog_(u,'saveCourse',record.id,{revision:record.revision});return record;}
function kfLearning_(u,d){const e=kfEnrollment_(u,d.enrollmentId);if(!kfPrereqsOk_(e))throw Error('Bitte zuerst die vorgeschaltete Fahrzeugausbildung abschließen.');if(u.role!=='participant')throw Error('Als Teilnehmer bestätigen.');if(!e.theoryLearned){kfSave_('Enrollments',{...e,theoryLearned:kfNow_()});const q=kfQuizFor_(e),c=kfFind_('Courses',e.courseId);if(q&&q.enabled&&!e.quizPassed)kfNotify_(u.id,'quiz-ready:'+e.id,e.requirements.quizRequired?'Pflichtquiz ist freigeschaltet':'Freiwilliges Quiz ist verfügbar',(c?.title||'Deine Fahrzeugausbildung')+': Du kannst deinen Wissenstest jetzt in der App absolvieren.',e.id);}return {ok:true};}
