function kfSaveSkill_(u,d){kfLearningRequire_();kfRequire_(u,'recordLessons');const e=kfEnrollment_(u,d.enrollmentId),m=kfFind_('Members',e.memberId);if(m.userId===u.id)throw Error('Eigene Fähigkeiten muss ein anderer Ausbilder bestätigen.');if(e.completedAt)throw Error('Abgeschlossene Ausbildungen bleiben unverändert.');const skill=kfSkillRequirements_(e).find(s=>s.id===d.skillId);if(!skill)throw Error('Fähigkeit gehört nicht zu dieser Ausbildungsfassung.');const level=kfNum_(d.level,1,3);if(!Number.isInteger(level))throw Error('Bewertungsstufe ungültig.');const date=kfDate_(d.date);if(!date||date>kfToday_())throw Error('Gültiges Ausbildungsdatum erforderlich.');const key=kfText_(d.clientKey,100);if(!key)throw Error('Speicherkennung fehlt.');const previous=kfRows_('SkillChecks').find(x=>x.clientKey===key);if(previous){if(previous.enrollmentId!==e.id||previous.skillId!==skill.id||previous.trainerId!==u.id)throw Error('Speicherkennung bereits anders verwendet.');return previous;}const current=kfSkillStatus_(e).find(s=>s.id===skill.id);if(current?.level===3&&level<3&&!kfText_(d.note,2000))throw Error('Für eine niedrigere Neubewertung bitte eine Begründung angeben.');const record={id:kfId_(),enrollmentId:e.id,memberId:e.memberId,skillId:skill.id,skillTitle:skill.title,level,date,note:kfText_(d.note,2000),trainerId:u.id,trainerName:u.name,at:kfNow_(),clientKey:key};kfSave_('SkillChecks',record);kfLog_(u,'skillCheck',record.id);return record;}
function kfPracticalExam_(u,d){kfLearningRequire_();const e=kfEnrollment_(u,d.enrollmentId),m=kfFind_('Members',e.memberId);if(m.userId===u.id)throw Error('Keine eigene Prüfung abnehmen.');if(!kfMayExamine_(u,e.vehicleId))throw Error('Keine Prüfberechtigung für dieses Fahrzeug.');const key=kfText_(d.clientKey,100);if(!key)throw Error('Speicherkennung fehlt.');const previous=kfRows_('PracticalExams').find(x=>x.clientKey===key);if(previous){if(previous.enrollmentId!==e.id||previous.examinerId!==u.id)throw Error('Speicherkennung bereits anders verwendet.');if(previous.passed&&d.complete===true&&!e.completedAt)kfComplete_(u,{enrollmentId:e.id,date:previous.date,examPassed:true,practicalExamId:previous.id});return previous;}
 if(e.completedAt)throw Error('Ausbildung bereits abgeschlossen.');if(!e.requirements.practicalEnabled)throw Error('Für diese Ausbildung ist keine praktische Abschlussprüfung vorgesehen.');if(!kfProgress_(e).canExam)throw Error('Theorie, Einschulungen, Fähigkeiten oder gültige Nachweise fehlen.');const criteria=kfExamRequirements_(e);if(!criteria.length)throw Error('Für diese Zuordnung ist kein neuer Prüfungsbogen vorgesehen. Den bisherigen Abschluss verwenden.');const date=kfDate_(d.date);if(!date||date>kfToday_())throw Error('Gültiges Prüfungsdatum erforderlich.');const marks=criteria.map(c=>{const mark=(d.marks||[]).find(x=>x.id===c.id);if(!mark||typeof mark.passed!=='boolean')throw Error('Jeden Prüfungspunkt ausdrücklich bewerten.');return {...c,passed:mark.passed,note:kfText_(mark.note,1000)};});const passed=marks.filter(x=>x.required).every(x=>x.passed);const record={id:kfId_(),enrollmentId:e.id,memberId:e.memberId,vehicleId:e.vehicleId,date,passed,marks,note:kfText_(d.note,2500),examinerId:u.id,examinerName:u.name,at:kfNow_(),clientKey:key,courseVersionId:e.courseVersionId};kfSave_('PracticalExams',record);kfLog_(u,'practicalExam',record.id);if(passed&&d.complete===true)kfComplete_(u,{enrollmentId:e.id,date,examPassed:true,practicalExamId:record.id});else if(!passed)kfNotify_(m.userId,'practical-result:'+record.id,'Praktische Prüfung: Nachschulung erforderlich','Die Bewertung zu '+(kfFind_('Vehicles',e.vehicleId)?.name||'deinem Fahrzeug')+' ist in deinem Ausbildungsprofil hinterlegt.',e.id);return record;}
