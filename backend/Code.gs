function kfMail_(userId,key,type,title,text,point){kfEvidenceReady_();const id=kfDigest_(key+':'+userId);if(kfFind_('MailQueue',id))return;kfSave_('MailQueue',{id,userId,key,type,title:kfText_(title,180),text:kfText_(text,5000),memberId:point.memberId,pointId:point.id,proofRevision:point.revision||0,approvedFileId:point.approved?.fileId||'',approvedExpires:point.approved?.expires||'',approvedRevision:point.approved?.revision||0,status:'pending',createdAt:kfNow_()});}
