function kfRequestProofsInternal_(u,m,kinds){kfEvidenceReady_();const changed=[];kinds.forEach(kind=>{kfProofName_(kind);const old=kfEvidencePoint_(m.id,kind);if(old&&old.approved)return;if(old&&['requested','submitted','awaiting_upload'].includes(old.status))return;const e={...(old||{}),id:old?old.id:kfId_(),memberId:m.id,kind,status:'requested',available:null,revision:(old?.revision||0)+1,requestedAt:kfNow_(),requestedBy:u.id};kfSave_('Evidence',e);changed.push(kfProofName_(kind));kfNotify_(m.userId,'proof:request:'+e.id+':'+e.revision,'Nachweis-Checkliste ergänzen','Bitte gib an, ob du '+kfProofName_(kind)+' besitzt, und lade bei vorhandenem Schein ein Dokument mit Gültigkeit hoch.',e.id);});if(changed.length){const point=kfEvidencePoint_(m.id,kinds.find(kind=>changed.includes(kfProofName_(kind))));kfMail_(m.userId,'proof:request-batch:'+m.id+':'+point.revision+':'+changed.join('|'),'request','Deine Nachweis-Checkliste','Hallo '+m.firstName+', bitte ergänze deine Checkliste: '+changed.join(', ')+'. Vorhandene Scheine müssen mit Dokument und Ablaufdatum oder ausdrücklich unbefristeter Gültigkeit hinterlegt werden.',point);}return {ok:true,count:changed.length};}
