function kfAblaufErinnerungenBase_(){return kfLock_(()=>{const today=kfToday_(),limit=Utilities.formatDate(new Date(Date.now()+60*86400000),'Europe/Vienna','yyyy-MM-dd');kfRows_('Members').filter(m=>m.active).forEach(m=>{const docs=(m.licences||[]).filter(l=>l.expires).map(l=>({label:'Führerscheinklasse '+l.class,date:l.expires}));if(m.fireLicenceExpires)docs.push({label:'Feuerwehrführerschein',date:m.fireLicenceExpires});docs.filter(x=>x.date<=limit).forEach(x=>{const days=Math.ceil((new Date(x.date+'T12:00:00Z')-new Date(today+'T12:00:00Z'))/86400000),band=days<0?'expired':days<=7?'7':days<=30?'30':'60',key='expiry:'+m.id+':'+x.label+':'+x.date+':'+band,title=days<0?'Nachweis abgelaufen':'Nachweis läuft bald ab',text=m.firstName+' '+m.lastName+': '+x.label+' – '+x.date+'. Bitte Verlängerung prüfen und aktualisierten Nachweis hinterlegen.';kfNotify_(m.userId,key,title,text,m.id);kfNotifyStaff_(key,title,text,m.id);});});return {ok:true};});}
