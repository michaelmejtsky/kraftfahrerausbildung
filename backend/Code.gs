function kfShuffle_(rows){const result=rows.slice();for(let i=result.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[result[i],result[j]]=[result[j],result[i]];}return result;}
function kfSelectQuestions_(quiz,practice){let qs=JSON.parse(JSON.stringify(quiz.questions||[]));if(quiz.shuffle||practice)qs=kfShuffle_(qs);const size=practice?0:Number(quiz.sampleSize)||0;if(size)qs=qs.slice(0,size);if(quiz.shuffle||practice)qs.forEach(q=>{if(q.type==='allocation'){q.items=kfShuffle_(q.items);return;}const pairs=kfShuffle_(q.options.map((text,index)=>({text,index})));q.options=pairs.map(p=>p.text);if(q.type==='multiple')q.correctOptions=pairs.flatMap((p,i)=>(q.correctOptions||[]).includes(p.index)?[i]:[]);else q.correct=pairs.findIndex(p=>p.index===q.correct);});return qs;}
