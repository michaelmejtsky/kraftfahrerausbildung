function kfReadChapter_(u,d){kfLearningRequire_();if(u.role!=='participant')throw Error('Lernkapitel im eigenen Ausbildungsprofil bestätigen.');const e=kfEnrollment_(u,d.enrollmentId);if(!kfPrereqsOk_(e))throw Error('Vorgeschaltete Fahrzeugausbildung noch nicht abgeschlossen.');const s=kfCurriculumSections_(kfCurriculum_(e)).find(s=>s.id===d.sectionId);if(!s)throw Error('Lernkapitel fehlt.');const id='chapter:'+kfDigest_(e.id+':'+s.id+':'+kfChapterFingerprint_(s));if(!kfFind_('LearningProgress',id))kfSave_('LearningProgress',{id,enrollmentId:e.id,memberId:e.memberId,sectionId:s.id,fingerprint:kfChapterFingerprint_(s),readAt:kfNow_()});return {ok:true};}
