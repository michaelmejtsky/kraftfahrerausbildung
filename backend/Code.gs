  const n=kfFind_('Notifications',q.notificationId),u=kfFind_('Users',q.userId),devices=kfRows_('PushDevices').filter(x=>x.active&&x.userId===q.userId);
  if(!n||n.userId!==q.userId||n.read||n.resolvedAt||!u||!u.active||!devices.length){kfSave_('PushQueue',{...q,status:'cancelled',finishedAt:kfNow_()});continue;}
  const claimId=kfId_();kfSave_('PushQueue',{...q,status:'processing',claimId,claimedMs:now});
  jobs.push({id:q.id,claimId,notification:{id:n.id,title:n.title,text:n.text},devices:devices.slice(0,10).map(x=>({id:x.id,subscription:x.subscription}))});
