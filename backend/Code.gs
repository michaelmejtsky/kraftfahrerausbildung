function kfSaveUser_(u,d){if(u.role!=='admin')kfRequire_(u,'manageTrainers');const old=d.id&&kfFind_('Users',d.id);if(d.id&&!old)throw Error('Konto fehlt.');if(old&&old.role==='participant')throw Error('Teilnehmer in der Teilnehmerverwaltung bearbeiten.');if(u.role!=='admin'&&((old&&!kfUserVisible_(u,old))||d.role!=='trainer'||(old&&old.role!=='trainer')))throw Error('Ausbildungschefs dürfen nur ihre eigenen Ausbilder verwalten.');if(!['admin','chief','trainer'].includes(d.role))throw Error('Rolle ungültig.');if(old&&old.id===u.id&&(d.role!==u.role||d.active===false))throw Error('Eigenen übergeordneten Zugang nicht deaktivieren oder herabstufen.');const email=kfEmail_(d.email),name=kfText_(d.name,160);if(!name)throw Error('Name fehlt.');if(kfRows_('Users').some(x=>x.id!==d.id&&x.email===email))throw Error('E-Mail bereits vergeben.');const defaults=d.role==='chief'?kfChiefDefaults_():kfTrainerDefaults_(),permissions={...defaults,...(d.permissions||{})};Object.keys(permissions).forEach(k=>{if(!Object.hasOwnProperty.call(KF_RIGHTS,k))delete permissions[k];else permissions[k]=permissions[k]===true;});if(u.role!=='admin')Object.keys(permissions).forEach(k=>{if(permissions[k]&&!kfCan_(u,k))throw Error('Du darfst keine Rechte weitergeben, die du selbst nicht besitzt.');});if(d.role==='trainer'){permissions.recognize=false;permissions.manageTrainers=false;permissions.manageEvidence=false;}const ids=[...new Set(d.examVehicleIds||[])];if(ids.some(id=>!kfFind_('Vehicles',id)))throw Error('Prüfungsfahrzeug fehlt.');if(u.role!=='admin'&&ids.some(id=>!kfMayExamine_(u,id)))throw Error('Prüfberechtigung liegt außerhalb deiner Fahrzeugfreigabe.');let managerId=u.role==='chief'?u.id:kfText_(d.managerId,100);if(managerId){const parent=kfFind_('Users',managerId);if(!parent||parent.role!=='chief'||!parent.active)throw Error('Aktiven Ausbildungschef auswählen.');}if(d.role!=='trainer')managerId='';const record={...(old||{}),id:old?old.id:kfId_(),name,email,number:kfText_(d.number,40),role:d.role,active:d.active!==false,permissions,examVehicleIds:ids,managerId,createdAt:old?old.createdAt:kfNow_()};kfSave_('Users',record);if(old&&old.email!==email)kfRows_('Invites').filter(x=>x.userId===old.id&&!x.usedAt).forEach(x=>kfSave_('Invites',{...x,revoked:true}));kfLog_(u,'saveUser',record.id,{role:record.role,permissions,examVehicleIds:ids});return kfPublic_(record);}
