function kfInvite_(u,d){const target=kfFind_('Users',d.userId);if(!target||!target.active)throw Error('Konto nicht aktiv.');if(target.role==='participant')kfRequire_(u,'manageMembers');else if(u.role!=='admin'){kfRequire_(u,'manageTrainers');if(!kfUserVisible_(u,target)||target.role!=='trainer')throw Error('Kein Zugriff auf diesen Ausbilderzugang.');}return kfInviteBase_({...u,role:'admin'},d);}
