 results.filter(r=>r.gone===true).forEach(r=>{const dev=kfFind_('PushDevices',r.id);if(dev&&dev.userId===q.userId&&dev.active)kfSave_('PushDevices',{...dev,active:false,updatedAt:kfNow_()});});
